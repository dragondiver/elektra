+void Application::OeffneLeitungImLeerlauf() {
+    // rundfunk: Die Leitung zur Bridge bleibt auch im Leerlauf offen, damit
+    // Symbole (Rueckrufe, Erinnerungen) sofort ankommen. Ist sie zu — Bridge
+    // neu gestartet, WLAN weg — wird sie hier neu geoeffnet; im Gespraech
+    // kuemmert sich der Gespraechspfad selbst um den Kanal.
+    if (GetDeviceState() != kDeviceStateIdle || !protocol_ || protocol_->IsAudioChannelOpened()) {
+        return;
+    }
+    ESP_LOGI(TAG, "rundfunk: Leitung zur Bridge oeffnen (Leerlauf)");
+    leise_verbindung_ = true;
+    protocol_->OpenAudioChannel();
+    leise_verbindung_ = false;
+    // OpenAudioChannel schaltet auf PERFORMANCE; im Leerlauf reicht LOW_POWER.
+    Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
+}
