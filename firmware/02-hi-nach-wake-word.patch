+void Application::SendeRundfunk(const std::string& json) {
+    Schedule([this, json]() {
+        if (protocol_ && protocol_->IsAudioChannelOpened()) {
+            protocol_->SendRundfunk(json);
+        } else {
+            ESP_LOGW(TAG, "rundfunk: kein Kanal, Nachricht verworfen: %s", json.c_str());
+        }
+    });
+}
