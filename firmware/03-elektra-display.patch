+// Akku: BAT_ADC liegt laut Schaltplan V2 an GPIO 8 (ADC1, Kanal 7), ueber
+// einen Teiler 200k/100k — die gemessene Spannung ist ein Drittel der
+// Zellenspannung. Eine Lithiumzelle ist zwischen 4,2 V und 3,4 V nicht
+// linear, deshalb Stuetzstellen statt Dreisatz.
+struct AkkuStuetzstelle { int mv; int prozent; };
+static const AkkuStuetzstelle AKKU_KENNLINIE[] = {
+    {4200, 100}, {4050, 90}, {3950, 80}, {3850, 60},
+    {3780, 40},  {3700, 20}, {3600, 10}, {3400, 0},
+};
+
+static int AkkuProzent(int mv) {
+    if (mv >= AKKU_KENNLINIE[0].mv) return 100;
+    const int n = sizeof(AKKU_KENNLINIE) / sizeof(AKKU_KENNLINIE[0]);
+    for (int i = 1; i < n; i++) {
+        const auto& hoch = AKKU_KENNLINIE[i - 1];
+        const auto& tief = AKKU_KENNLINIE[i];
+        if (mv >= tief.mv) {
+            return tief.prozent + (mv - tief.mv) * (hoch.prozent - tief.prozent) / (hoch.mv - tief.mv);
+        }
+    }
+    return 0;
+}
