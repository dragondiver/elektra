+            lv_point_t p;
+            lv_indev_get_point(lv_indev_active(), &p);
+            auto* display = static_cast<ElektraDisplay*>(Board::GetInstance().GetDisplay());
+            if (const char* art = display->SymbolAn(p.x, p.y)) {
