+
+    bool InitializeAkku() {
+        adc_oneshot_unit_init_cfg_t unit = {};
+        unit.unit_id = ADC_UNIT_1;
+        if (adc_oneshot_new_unit(&unit, &akku_adc_) != ESP_OK) {
+            ESP_LOGW(TAG, "Akku-ADC nicht verfuegbar");
+            return false;
+        }
+        adc_oneshot_chan_cfg_t kanal = {};
+        kanal.atten = ADC_ATTEN_DB_12;
+        kanal.bitwidth = ADC_BITWIDTH_12;
+        ESP_ERROR_CHECK(adc_oneshot_config_channel(akku_adc_, ADC_CHANNEL_7, &kanal));  // GPIO 8
+        adc_cali_curve_fitting_config_t cali = {};
+        cali.unit_id = ADC_UNIT_1;
+        cali.chan = ADC_CHANNEL_7;
+        cali.atten = ADC_ATTEN_DB_12;
+        cali.bitwidth = ADC_BITWIDTH_12;
+        if (adc_cali_create_scheme_curve_fitting(&cali, &akku_cali_) != ESP_OK) {
+            ESP_LOGW(TAG, "Akku-ADC ohne Kalibrierung");
+            akku_cali_ = nullptr;
+        }
+        return true;
+    }
+
+    int AkkuMillivolt() {
+        int roh = 0, mv = 0;
+        esp_err_t err = adc_oneshot_read(akku_adc_, ADC_CHANNEL_7, &roh);
+        if (err != ESP_OK) {
+            ESP_LOGW(TAG, "Akku-ADC lesen: %s", esp_err_to_name(err));
+            return 0;
+        }
+        if (akku_cali_) {
+            adc_cali_raw_to_voltage(akku_cali_, roh, &mv);
+        } else {
+            mv = roh * 3300 / 4095;
+        }
+        ESP_LOGI(TAG, "Akku-ADC roh %d -> %d mV am Pin", roh, mv);
+        return mv * 3;   // Teiler 200k/100k
+    }
 
