+    virtual bool GetBatteryLevel(int& level, bool& charging, bool& discharging) override {
+        if (akku_adc_ == nullptr) return false;
+        int64_t jetzt = esp_timer_get_time();
+        if (akku_zuletzt_us_ == 0 || jetzt - akku_zuletzt_us_ > 30 * 1000 * 1000) {
+            int mv = AkkuMillivolt();
+            if (mv > 0) {   // 0 = Lesefehler, nicht in den Mittelwert mischen
+                akku_mv_mittel_ = akku_mv_mittel_ == 0 ? mv : (akku_mv_mittel_ * 7 + mv) / 8;
+            }
+            akku_zuletzt_us_ = jetzt;
+            ESP_LOGI(TAG, "Akku: %d mV -> %d %%", akku_mv_mittel_, AkkuProzent(akku_mv_mittel_));
+        }
+        if (akku_mv_mittel_ < 2500) {
+            return false;       // kein Akku am Messpunkt (Schalter aus oder nicht bestueckt)
+        }
+        level = AkkuProzent(akku_mv_mittel_);
+        charging = false;       // ETA6098 hat keinen Pin am ESP (Schaltplan V2)
+        discharging = true;
+        return true;
+    }
     
