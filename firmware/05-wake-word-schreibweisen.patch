+static constexpr float MESSSCHWELLE = 0.03f;
+static constexpr float WAKE_GAIN = 3.0f;
+
+// rundfunk: mehrere Schreibweisen desselben Wake-Words, mit ';' getrennt. Das
+// englische MultiNet-Modell kennt nur seine eigene Aussprache von "elektra";
+// deutsche Varianten erhöhen die Trefferquote (13.09.2026).
+static std::vector<std::string> SchreibweisenTrennen(const std::string& alle) {
+    std::vector<std::string> ergebnis;
+    size_t start = 0;
+    while (start <= alle.size()) {
+        size_t ende = alle.find(';', start);
+        if (ende == std::string::npos) ende = alle.size();
+        std::string wort = alle.substr(start, ende - start);
+        size_t a = wort.find_first_not_of(' ');
+        size_t b = wort.find_last_not_of(' ');
+        if (a != std::string::npos) ergebnis.push_back(wort.substr(a, b - a + 1));
+        start = ende + 1;
+    }
+    return ergebnis;
+}
 
