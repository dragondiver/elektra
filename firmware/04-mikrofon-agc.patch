diff --git a/main/audio/codecs/box_audio_codec.cc b/main/audio/codecs/box_audio_codec.cc
index 5210ecb..d921f28 100644
--- a/main/audio/codecs/box_audio_codec.cc
+++ b/main/audio/codecs/box_audio_codec.cc
@@ -10,10 +10,20 @@ BoxAudioCodec::BoxAudioCodec(void* i2c_master_handle, int input_sample_rate, int
                              gpio_num_t mclk, gpio_num_t bclk, gpio_num_t ws, gpio_num_t dout,
                              gpio_num_t din, gpio_num_t pa_pin, uint8_t es8311_addr,
                              uint8_t es7210_addr, bool input_reference, float input_gain,
-                             int reference_gain_channel, float reference_gain) {
+                             int reference_gain_channel, float reference_gain, int mic_count) {
     duplex_ = true;                              // 是否双工
     input_reference_ = input_reference;          // 是否使用参考输入，实现回声消除
-    input_channels_ = input_reference_ ? 2 : 1;  // 输入通道数
+    mic_count_ = mic_count;
+    // rundfunk (13.09.2026): Das Waveshare-1.85C hat zwei Mikrofone an MIC1 und
+    // MIC2 des ES7210, der Lautsprecher-Rueckweg liegt an MIC3. Die TDM-Slots
+    // kommen in der Reihenfolge MIC1, MIC3, MIC2, MIC4 — mit zwei Mikrofonen
+    // lesen wir drei Slots und das AFE bekommt "MRM".
+    if (mic_count_ >= 2 && input_reference_) {
+        input_channels_ = 3;
+        input_format_ = "MMR";
+    } else {
+        input_channels_ = input_reference_ ? 2 : 1;  // 输入通道数
+    }
     input_sample_rate_ = input_sample_rate;
     output_sample_rate_ = output_sample_rate;
     input_gain_ = input_gain;
@@ -206,9 +216,17 @@ void BoxAudioCodec::EnableInput(bool enable) {
         if (input_reference_) {
             fs.channel_mask |= ESP_CODEC_DEV_MAKE_CHANNEL_MASK(1);
         }
+        if (input_channels_ >= 3) {
+            fs.channel_mask |= ESP_CODEC_DEV_MAKE_CHANNEL_MASK(2);  // TDM-Slot 2 = MIC2
+        }
         ESP_ERROR_CHECK(esp_codec_dev_open(input_dev_, &fs));
         ESP_ERROR_CHECK(esp_codec_dev_set_in_channel_gain(
             input_dev_, ESP_CODEC_DEV_MAKE_CHANNEL_MASK(0), input_gain_));
+        if (mic_count_ >= 2) {
+            // Gain-Masken zaehlen physisch: Index 1 = MIC2.
+            ESP_ERROR_CHECK(esp_codec_dev_set_in_channel_gain(
+                input_dev_, ESP_CODEC_DEV_MAKE_CHANNEL_MASK(1), input_gain_));
+        }
         if (input_reference_ && reference_gain_channel_ >= 0) {
             // ES7210 gain masks use physical MIC numbering, which differs
             // from the TDM slot order (MIC1, MIC3, MIC2, MIC4).
@@ -247,6 +265,16 @@ void BoxAudioCodec::EnableOutput(bool enable) {
 int BoxAudioCodec::Read(int16_t* dest, int samples) {
     if (input_enabled_) {
         ESP_ERROR_CHECK_WITHOUT_ABORT(esp_codec_dev_read(input_dev_, (void*)dest, samples * sizeof(int16_t)));
+        if (input_channels_ == 3) {
+            // rundfunk: TDM liefert MIC1, MIC3(Rueckweg), MIC2 — das AFE bekommt
+            // "MMR" (Mikrofone zuerst, wie bei der ESP-BOX); "MRM" lieferte
+            // Muell (13.09.2026).
+            for (int i = 0; i + 2 < samples; i += 3) {
+                int16_t r = dest[i + 1];
+                dest[i + 1] = dest[i + 2];
+                dest[i + 2] = r;
+            }
+        }
     }
     return samples;
 }
